# Docker Compose settings. Copy to `.env` in the repository root; Compose reads it for
# the variables in docker-compose.yml and docker-compose.demo.yml. The backend and frontend
# have their own settings in backend/.env and frontend/.env.

# Postgres credentials, used to create the database and to build the backend's
# DATABASE_URL. Leave POSTGRES_PASSWORD empty to have a random one generated on first start
# (kept in the `db-secrets` volume). Postgres only reads it when the database is first
# created: changing it later breaks the backend's connection.
POSTGRES_PASSWORD=
# POSTGRES_USER=gravnet
# POSTGRES_DB=gravnet

# The domains Caddy serves and gets HTTPS certificates for (required). Both must resolve to
# this machine, with ports 80 and 443 open. Match them to FRONTEND_URL and BACKEND_URL in
# backend/.env.
SITE_DOMAIN=
API_DOMAIN=

# Per-IP rate limit (see Caddyfile): at most RATE_LIMIT_EVENTS requests in any
# RATE_LIMIT_WINDOW, counted separately for the site and the API. Game servers' /gnet
# requests get RATE_LIMIT_GNET_EVENTS instead. Over the limit gets 429.
# RATE_LIMIT_EVENTS=600
# RATE_LIMIT_GNET_EVENTS=1200
# RATE_LIMIT_WINDOW=1m
