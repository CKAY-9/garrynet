# Docker Compose settings. Copy to `.env` in the repository root; Compose reads it for
# the variables in docker-compose.yml and docker-compose.demo.yml. The backend and frontend
# have their own settings in backend/.env and frontend/.env.

# Postgres credentials, used to create the database and to build the backend's
# DATABASE_URL. Set a strong password: it defaults to `garrynet`.
POSTGRES_PASSWORD=
# POSTGRES_USER=garrynet
# POSTGRES_DB=garrynet

# Host ports the backend and frontend are published on (point your reverse proxy at them).
# Unused with docker-compose.demo.yml, where only Caddy publishes ports (80 and 443).
# BACKEND_PORT=8080
# FRONTEND_PORT=3000

# docker-compose.demo.yml only (docs/DEMO.md): the domains Caddy serves and gets HTTPS
# certificates for. Both must resolve to this machine. Match them to FRONTEND_URL and
# BACKEND_URL in backend/.env.
# SITE_DOMAIN=gnet.example.com
# API_DOMAIN=api.gnet.example.com
