# Address the HTTP server binds to.
BIND_ADDR=127.0.0.1:8080

DATABASE_URL=postgres://gravnet:gravnet@localhost:5432/gravnet
# Optional. A file holding the database password, which replaces the one in DATABASE_URL
# (trailing newlines are ignored). Docker Compose sets it to the generated password.
# DATABASE_PASSWORD_FILE=

# Public URL of this backend, as seen by the browser. Used as the Steam OpenID
# realm and to build the /auth/steam/callback return URL. Release builds require https://
# outside localhost (README "HTTPS"); with https:// the backend also sends HSTS.
BACKEND_URL=http://localhost:8080

# Where users are sent after logging in or out. https:// outside localhost, like BACKEND_URL.
FRONTEND_URL=http://localhost:3000

# HMAC secret for signing user JWTs. At least 32 bytes; e.g. `openssl rand -base64 48`.
JWT_SECRET=

# https://steamcommunity.com/dev/apikey — used to fetch the Steam username and avatar.
STEAM_API_KEY=

# Optional. Set when the frontend and backend are on different subdomains
# (e.g. COOKIE_DOMAIN=example.com for example.com + api.example.com) so the
# frontend's Next.js server receives the auth cookie. Leave empty for localhost.
COOKIE_DOMAIN=

# Optional. Defaults to true when BACKEND_URL is https. Release builds refuse false outside
# localhost.
# COOKIE_SECURE=true

# Store payments (docs/STORE.md). Set both or neither: without them the store can be
# browsed and managed but nothing can be bought.
# https://dashboard.stripe.com/apikeys — the secret key (sk_live_... / sk_test_...).
STRIPE_SECRET_KEY=
# Signing secret of a webhook endpoint pointed at BACKEND_URL/stripe/webhook, subscribed to
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded,
# charge.refund.updated, charge.dispute.created and charge.dispute.closed. Locally: `stripe listen --forward-to localhost:8080/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Optional. Ask Stripe Tax to add tax at checkout (needs Stripe Tax enabled on the account).
# STRIPE_TAX=true
# With STRIPE_TAX: `exclusive` (default) adds tax on top of item prices, `inclusive` means
# prices already include it.
# STRIPE_TAX_BEHAVIOR=exclusive

# Optional. Demo mode (docs/DEMO.md): only Stripe test keys are accepted, and everything
# users without Admin Access create is deleted daily at midnight UTC. docker-compose.demo.yml
# sets it. Never enable it on a real community.
# DEMO_MODE=false

# File storage (docs/STORAGE.md). `local` (default) or `s3`. Files keep the provider they
# were uploaded with, so switching only affects new uploads.
# STORAGE_PROVIDER=local
# Root directory of the local provider.
# STORAGE_LOCAL_PATH=./storage
# Largest upload in bytes (default 2MB), and average seconds between uploads by the same
# user (10 can be made back to back).
# STORAGE_MAX_FILE_SIZE=2097152
# STORAGE_RATE_LIMIT=3
# Most bytes a user may hold in uploads not yet attached to anything (default 20 times
# STORAGE_MAX_FILE_SIZE).
# STORAGE_USER_QUOTA=41943040

# Local Garage (see /garage.toml): S3_BUCKET=gravnet, S3_ENDPOINT=http://localhost:3900,
# S3_REGION=garage, S3_ACCESS_KEY_ID=GK0123456789abcdef01234567,
# S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). Setting S3_BUCKET enables it; the
# bucket needs a CORS rule allowing PUT from FRONTEND_URL if browsers upload directly.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# `auto` for R2.
# S3_REGION=us-east-1
# For anything but AWS, e.g. https://<account>.r2.cloudflarestorage.com. Plain http:// only for
# localhost or a single-label name on a private network (e.g. http://minio:9000).
# S3_ENDPOINT=
# Optional public URL of the bucket (custom domain/CDN); otherwise reads use presigned URLs.
# This makes the bucket public: support ticket and private message attachments then stay
# readable at this URL by anyone who has ever opened them (or seen their link), even after
# losing access. Leave it unset if those attachments must stay private.
# S3_PUBLIC_URL=

RUST_LOG=info
