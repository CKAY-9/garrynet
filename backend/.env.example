# Address the HTTP server binds to.
BIND_ADDR=127.0.0.1:8080

DATABASE_URL=postgres://garrynet:garrynet@localhost:5432/garrynet

# Public URL of this backend, as seen by the browser. Used as the Steam OpenID
# realm and to build the /auth/steam/callback return URL.
BACKEND_URL=http://localhost:8080

# Where users are sent after logging in or out.
FRONTEND_URL=http://localhost:3000

# HMAC secret for signing user JWTs. At least 32 bytes; e.g. `openssl rand -base64 48`.
JWT_SECRET=

# https://steamcommunity.com/dev/apikey — used to fetch the Steam username and avatar.
STEAM_API_KEY=

# Optional. Set when the frontend and backend are on different subdomains
# (e.g. COOKIE_DOMAIN=example.com for example.com + api.example.com) so the
# frontend's Next.js server receives the auth cookie. Leave empty for localhost.
COOKIE_DOMAIN=

# Optional. Defaults to true when BACKEND_URL is https.
# COOKIE_SECURE=true

# Store payments (docs/STORE.md). Set both or neither: without them the store can be
# browsed and managed but nothing can be bought.
# https://dashboard.stripe.com/apikeys — the secret key (sk_live_... / sk_test_...).
STRIPE_SECRET_KEY=
# Signing secret of a webhook endpoint pointed at BACKEND_URL/stripe/webhook, subscribed to
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded and
# charge.dispute.created. Locally: `stripe listen --forward-to localhost:8080/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Optional. Ask Stripe Tax to add tax at checkout (needs Stripe Tax enabled on the account).
# STRIPE_TAX=true

RUST_LOG=info
