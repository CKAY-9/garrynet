# Environment files (commit only the examples)
.env
.env.*
!.env.example

# Rust backend
/backend/target/
# Local file storage (STORAGE_LOCAL_PATH default)
/backend/storage/
**/*.rs.bk
*.pdb

# Frontend (Next.js) — see frontend/.gitignore for the rest
node_modules/
.next/

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
