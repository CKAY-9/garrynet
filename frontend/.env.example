# GravNet backend URL used by the Next.js server (server-to-server requests).
# Defaults to NEXT_PUBLIC_API_URL when unset. Production servers require https:// unless it's
# localhost or a single-label name on a private network (e.g. http://backend:8080).
API_URL=http://localhost:8080

# GravNet backend URL as seen by the browser (Login with Steam / Log out).
# Inlined at build time. Production builds require https:// outside localhost.
NEXT_PUBLIC_API_URL=http://localhost:8080
